{
  "manifest_version": 3,
  "name": "Словолупа — карта частотности",
  "version": "1.2.2",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "description": "Частотная карта абзацев и выделений: русский и английский, основы слов, водность. Анализ на вашем устройстве.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Словолупа — настройки",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_about_blank": true
  }]
}
